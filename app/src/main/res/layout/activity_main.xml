<?xml version="1.0" encoding="utf-8"?>

<!--
    Layout principal de la pantalla Home.

    Estructura:
    - Header (cabecera)
    - Body (contenido principal)
    - Footer (pie de página)

    Se utilizan colores definidos por roles en colors.xml:
    primary, primary_dark, surface, text_primary, etc.
-->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- ===================================================== -->
    <!-- HEADER                                                 -->
    <!-- ===================================================== -->

    <!--
        Cabecera de la aplicación.
        orientation="horizontal"
        permite colocar los elementos de izquierda a derecha.
    -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <!--
            Logo de la aplicación.
            tint permite colorear el vector drawable
            utilizando los colores definidos en la app.
        -->
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/logo_description"
            android:src="@drawable/ic_android"
            app:tint="@color/white" />

        <!--
            El title ocupa todo el espacio sobrante.
            layout_width="0dp" + layout_weight="1"
            hace que empuje el menú hacia el extremo derecho.
        -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/home_title"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!--
            Menú hamburguesa.
        -->
        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/menu_description"
            android:src="@drawable/ic_menu"
            app:tint="@color/white" />

    </LinearLayout>

    <!-- ===================================================== -->
    <!-- BODY                                                   -->
    <!-- ===================================================== -->
    <!--
        Este contenedor ocupa todo el espacio libre
        entre el Header y el Footer.

        Seguimos usando layout_weight=1 aquí porque es
        el único elemento que debe expandirse entre ambos.
    -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/surface"
        android:padding="12dp">

        <!-- ================================================= -->
        <!-- FILTROS                                           -->
        <!-- ================================================= -->

        <!-- Grupo de Chips -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFiltros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:singleSelection="true">

            <!-- Chip Populares -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chipPopulares"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:checked="true"
                android:text="@string/popular"
                android:textColor="@color/chip_text_color"
                app:chipBackgroundColor="@color/chip_background" />

            <!-- Chip Tendencias -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chipTendencias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/trending"
                android:textColor="@color/chip_text_color"
                app:chipBackgroundColor="@color/chip_background" />

            <!-- Chip Estrenos -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chipEstrenos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/upcoming"
                android:textColor="@color/chip_text_color"
                app:chipBackgroundColor="@color/chip_background" />

        </com.google.android.material.chip.ChipGroup>

        <!-- ================================================= -->
        <!-- TÍTULO                                            -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvTituloPeliculas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/popular_movies"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/chipGroupFiltros" />

        <!-- ================================================= -->
        <!-- BUSCADOR                                          -->
        <!-- ================================================= -->

        <!--
            width=0dp en ConstraintLayout NO significa ancho cero.
            Significa:
            "ocupa todo el espacio disponible entre las
            restricciones izquierda y derecha".
        -->
        <EditText
            android:id="@+id/etBuscar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_search"
            android:elevation="6dp"
            android:hint="@string/search_movie"
            android:importantForAutofill="no"
            android:inputType="text"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTituloPeliculas" />

        <!-- ================================================= -->
        <!-- CARROUSEL DE PELÍCULAS                            -->
        <!-- ================================================= -->

        <!--
            Ocupa automáticamente todo el espacio disponible
            entre el buscador y el final del Body gracias
            a las restricciones de ConstraintLayout.

            Más adelante se asociará a un Adapter para
            mostrar películas reales.
        -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMovies"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            app:layout_constraintTop_toBottomOf="@id/etBuscar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ===================================================== -->
    <!-- FOOTER                                                 -->
    <!-- ===================================================== -->

    <!--
        Pie de página.
        Utiliza primary_dark para generar contrast
        respecto del Header.
    -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/primary_dark"
        android:gravity="center"
        android:text="@string/footer_text"
        android:textColor="@color/white" />

</LinearLayout>