<?xml version="1.0" encoding="utf-8"?>
<!-- Indica que el archivo está escrito en XML y usa codificación UTF‑8. -->

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Raíz del manifiesto: aquí se definen los componentes globales de la app -->
    <!-- También se pueden declarar permisos, por ejemplo:
         <uses-permission android:name="android.permission.INTERNET" /> -->

    <uses-permission android:name="android.permission.INTERNET" />

    <application

        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Seminario">

        <!-- Sección principal de la aplicación -->
        <!-- Aquí se declaran todas las pantallas (activities), services y receptors -->
        <!-- Cada <activity> representa una pantalla o vista dentro de la app -->

        <!-- Actividad principal de la app -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">

            <!-- Filtro de intención: define cómo se lanza esta actividad -->
            <intent-filter>
                <!-- MAIN: punto de entrada principal -->
                <action android:name="android.intent.action.MAIN" />
                <!-- LAUNCHER: hace que aparezca en el menú del dispositivo -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Aquí podrías agregar más actividades, por ejemplo:
        <activity android:name=".LoginActivity" />
        <activity android:name=".ProfileActivity" /> -->

    </application>

</manifest>